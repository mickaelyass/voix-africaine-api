# ==========================================
# MODÈLE DE CONFIGURATION — copier vers .env
# cp .env.example .env
# ==========================================

# ==========================================
# APPLICATION
# ==========================================

# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PREFIX=/api


# ==========================================
# ADMIN PAR DÉFAUT
# Créé automatiquement au premier lancement s'il n'existe aucun admin.
# ==========================================

DEFAULT_ADMIN_EMAIL=admin@voixafricaine.com
DEFAULT_ADMIN_PASSWORD=change-me-en-local-dans-votre-.env
DEFAULT_ADMIN_FULL_NAME=Administrateur


# ==========================================
# MONGODB (instance locale)
# ==========================================

MONGO=mongodb://localhost:27017
MONGO_DB_NAME=voix_africaine

# Pool de connexions — réduit la latence des requêtes répétées
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000


# ==========================================
# RATE LIMITING (sécurité)
# ==========================================
# Protège contre le brute-force et le DDoS.
# Mettre RATE_LIMIT_ENABLED=false en dev local si nécessaire.

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=120
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60


# ==========================================
# UPLOAD AUDIO
# ==========================================

MAX_AUDIO_UPLOAD_MB=50
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a,webm,flac
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/mp4,audio/x-m4a,audio/webm,audio/flac


# ==========================================
# LOGGING / OBSERVABILITÉ
# ==========================================
# LOG_FORMAT: "json" (prod) ou "text" (dev local)

LOG_LEVEL=INFO
LOG_FORMAT=text


# ==========================================
# GOOGLE AUTH
# ==========================================

GOOGLE_CLIENT_ID=TON_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TON_GOOGLE_CLIENT_SECRET


# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret