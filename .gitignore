# ============ SECRETS — jamais sur GitHub ============
# Le .env réel (dev local) et toutes ses variantes restent locaux.
# En production, renseigner les variables dans le dashboard (Render > Environment)
# — aucun fichier .env n'est déployé.
.env
.env.*
!.env.example

# ============ PYTHON ============
__pycache__/
*.py[cod]
*$py.class

# ============ SCRIPTS LOCAUX (dev/test — jamais en production ni sur GitHub) ============
# smoke_test / test_audio_flow : contiennent des identifiants admin en dur.
# import_chevre : import de données one-shot. run_dev.sh : lancement local.
# En prod, le bootstrap (app/bootstrap.py) crée index + admin automatiquement.
scripts/smoke_test.py
scripts/test_audio_flow.py
scripts/import_chevre.py
scripts/run_dev.sh
*.so
*.egg-info/
.eggs/
build/
dist/

# ============ ENVIRONNEMENTS VIRTUELS ============
.venv/
venv/
env/
ENV/
.python-version

# ============ OUTILS / CACHES ============
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
.coverage
.coverage.*
htmlcov/

# ============ LOGS & RUNTIME ============
*.log
logs/
*.sqlite3
uploads/

# ============ IDE / OS ============
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============ DOCKER ============
# (docker-compose.yml ne contient AUCUN secret en dur)
